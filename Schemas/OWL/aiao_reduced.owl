<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.org/aiaontology#"
     xml:base="http://purl.org/aiaontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
	 xmlns:claim="http://www.example.org/claim-ontology#">
	 
    <owl:Ontology rdf:about="http://purl.org/aiaontology">
        <terms:description xml:lang="en">This ontology is a tool for aggregating and consolidating anthropogenic impact accounting data across different standards and vocabularies. The ontology is intended to be generic enough to be used for anthropogenic impact accounting in almost any discipline and context, including climate action impact accounting./s</terms:description>
        <terms:source rdf:resource="https://wiki.hyperledger.org/display/CASIG/An+ontology+for+anthropogenic+impact+accounting"/>
        <terms:title xml:lang="en">An Ontology for Anthropogenic Impact Accounting</terms:title>
    </owl:Ontology>

	<owl:Class rdf:ID="StateClaim">
		<rdfs:subClassOf rdf:resource="claim:Claim"/>
		<rdfs:label>State Claim</rdfs:label>
		<rdfs:comment>A statement about the state of a thing.</rdfs:comment>
	</owl:Class>
	
	<owl:Class rdf:ID="ImpactClaim">
		<rdfs:subClassOf rdf:resource="claim:Claim"/>
		<rdfs:label>Impact Claim</rdfs:label>
		<rdfs:comment>A statement about the impact of an event on a thing, expressed in terms of a state difference.</rdfs:comment>
	</owl:Class>
	
    <owl:ObjectProperty rdf:about="http://purl.org/impact-ontology#defines">
        <owl:inverseOf rdf:resource="http://purl.org/impact-ontology#isDefinedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/impact-ontology#Parameter"/>
        <rdfs:range rdf:resource="http://purl.org/impact-ontology#Environment"/>
        <rdfs:comment xml:lang="en">A collection of Parameters defines an Environment.</rdfs:comment>
    </owl:ObjectProperty>

    <!-- http://purl.org/impact-ontology#enacts -->
    <owl:ObjectProperty rdf:about="http://purl.org/impact-ontology#enacts">
        <owl:inverseOf rdf:resource="http://purl.org/impact-ontology#isEnactedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/impact-ontology#Agent"/>
        <rdfs:range rdf:resource="http://purl.org/impact-ontology#Role"/>
    </owl:ObjectProperty>
	
    <!-- http://purl.org/impact-ontology#engagesIn -->
    <owl:ObjectProperty rdf:about="http://purl.org/impact-ontology#engagesIn">
        <owl:inverseOf rdf:resource="http://purl.org/impact-ontology#isPerformedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/impact-ontology#Agent"/>
        <rdfs:range rdf:resource="http://purl.org/impact-ontology#Activity"/>
    </owl:ObjectProperty>


    <!-- http://purl.org/impact-ontology#hasInput -->
    <owl:ObjectProperty rdf:about="http://purl.org/impact-ontology#hasInput">
        <rdfs:domain rdf:resource="http://purl.org/impact-ontology#Activity"/>
        <rdfs:range rdf:resource="http://purl.org/impact-ontology#Thing"/>
    </owl:ObjectProperty>	
    
    <!-- #hasOutput -->
    <owl:ObjectProperty rdf:about="#hasOutput">
        <rdfs:domain rdf:resource="#Activity"/>
        <rdfs:range rdf:resource="#Thing"/>
    </owl:ObjectProperty>

    <!-- #operates -->
    <owl:ObjectProperty rdf:about="#operates">
        <rdfs:domain rdf:resource="#Operator"/>
        <rdfs:range rdf:resource="#Instrument"/>
    </owl:ObjectProperty>
    	
    <!-- #isPerformedWith -->
    <owl:ObjectProperty rdf:about="#isPerformedWith">
        <owl:inverseOf rdf:resource="#isUsedToPerform"/>
        <rdfs:domain rdf:resource="#Activity"/>
        <rdfs:range rdf:resource="#Instrument"/>
    </owl:ObjectProperty>
    


    <!-- #isUsedToPerform -->
    <owl:ObjectProperty rdf:about="#isUsedToPerform">
        <rdfs:domain rdf:resource="#Instrument"/>
        <rdfs:range rdf:resource="#Activity"/>
    </owl:ObjectProperty>

    <!-- #hasActivityCode -->
    <owl:DatatypeProperty rdf:about="#hasActivityCode">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
	
    <!-- #isPerformedBy -->
    <owl:ObjectProperty rdf:about="#isPerformedBy">
        <rdfs:domain rdf:resource="#Activity"/>
        <rdfs:range rdf:resource="#Agent"/>
    </owl:ObjectProperty>
    	
		
		
    <owl:Class rdf:about="#AccountingPeriod">
        <rdfs:subClassOf rdf:resource="#Period"/>
        <rdfs:label xml:lang="en">AccountingPeriod</rdfs:label>
    </owl:Class>
    


    <!-- #Activity -->

    <owl:Class rdf:about="#Activity">
        <owl:equivalentClass rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <owl:disjointWith rdf:resource="#Event"/>
        <rdfs:comment xml:lang="en">A thing that an agent does and which impacts an environment.</rdfs:comment>
        <rdfs:comment xml:lang="en">An Activity may comprise other Activities, e.g., a project (an Activity) consists of many Activities. Use the &apos;comprises&apos; property to indicate this.</rdfs:comment>
        <skos:altLabel xml:lang="en">Action</skos:altLabel>
        <rdfs:subClassOf rdf:resource="#Thing"/>
    </owl:Class>
    


    <!-- #Agent -->

    <owl:Class rdf:about="#Agent">
        <owl:equivalentClass rdf:resource="http://purl.org/dc/terms/AgentClass"/>
        <owl:equivalentClass rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">An agent is a thing that bears some form of responsibility for an activity taking place or for the existence of another thing, and which can be held accountable for it.</rdfs:comment>
        <rdfs:label xml:lang="en">Agent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:subClassOf rdf:resource="#Thing"/>
    </owl:Class>

    <!-- #CyberPersona -->
    <owl:Class rdf:about="#CyberPersona">
        <rdfs:subClassOf rdf:resource="#Agent"/>
        <rdfs:label>CyberPersona</rdfs:label>
    </owl:Class>
    



    <!-- #Environment -->
    <owl:Class rdf:about="#Environment">
        <rdfs:comment xml:lang="en">(PROPOSED) The surroundings and conditions in which a thing exists.</rdfs:comment>
        <rdfs:label xml:lang="en">Environment</rdfs:label>
        <rdfs:subClassOf rdf:resource="#Thing"/>
    </owl:Class>
    

    <!-- #CreditingPeriod -->
    <owl:Class rdf:about="#CreditingPeriod">
        <rdfs:subClassOf rdf:resource="#Period"/>
    </owl:Class>
	
	
    <!-- #Instrument -->
    <owl:Class rdf:about="#Instrument">
        <rdfs:label xml:lang="en">Instrument</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A thing used to perform an activity.</skos:definition>
        <rdfs:subClassOf rdf:resource="#Thing"/>
    </owl:Class>	
	
	
    <!-- #LegalPerson -->
    <owl:Class rdf:about="#LegalPerson">
        <owl:equivalentClass rdf:resource="http://www.wikidata.org/wiki/Q3778211"/>
        <rdfs:subClassOf rdf:resource="#Agent"/>
    </owl:Class>	
	
    <!-- #NaturalPerson -->
    <owl:Class rdf:about="#NaturalPerson">
        <owl:equivalentClass rdf:resource="http://www.wikidata.org/wiki/Q154954"/>
        <rdfs:subClassOf rdf:resource="#Agent"/>
    </owl:Class>	
	

    <!-- #Operator -->

    <owl:Class rdf:about="#Operator">
        <rdfs:subClassOf rdf:resource="#Role"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Operator</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A set of predefined behaviours for an agent who operates a specific thing (e.g., an instrument) in the context of a specific activity.</skos:definition>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="#Operator"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#equivalentClass"/>
        <owl:annotatedTarget>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#operates"/>
                <owl:someValuesFrom rdf:resource="#Instrument"/>
            </owl:Restriction>
        </owl:annotatedTarget>
        <rdfs:comment xml:lang="en">The requirement for an Agent to fulfill the Role of Operator is that they operate some Instrument.</rdfs:comment>
    </owl:Axiom>
    


    <!-- #Owner -->

    <owl:Class rdf:about="#Owner">
        <rdfs:subClassOf rdf:resource="#Role"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Owner</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A set of predefined behaviours for an agent who owns a specific thing in the context of a specific activity.</skos:definition>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="#Owner"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#equivalentClass"/>
        <owl:annotatedTarget>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#owns"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </owl:annotatedTarget>
        <rdfs:comment xml:lang="en">The requirement for an Agent to fulfill the Role of Owner is that they own some owl:Thing.</rdfs:comment>
    </owl:Axiom>	
	
	
	
    <!-- #Project -->

    <owl:Class rdf:about="#Project">
        <rdfs:subClassOf rdf:resource="#Process"/> <!--TODO: Change this to being a subclass of impactont:Process-->
        <rdfs:label>Project</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unique process, consisting of a set of coordinated activities, undertaken to achieve an objective under specific controls.</skos:definition>
    </owl:Class>
    


    <!-- #ProjectDeveloper -->
    <owl:Class rdf:about="#ProjectDeveloper">
        <rdfs:subClassOf rdf:resource="#Role"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Project Developer</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A set of predefined behaviours for an agent who defines and prepares the conditions for a project.</skos:definition>
    </owl:Class>
    


    <!-- #ProjectPeriod -->
    <owl:Class rdf:about="#ProjectPeriod">
        <rdfs:subClassOf rdf:resource="#Period"/>
    </owl:Class>
    


    <!-- #Role -->

    <owl:Class rdf:about="#Role">
        <rdfs:subClassOf rdf:resource="#Control(n)"/>
        <rdfs:label xml:lang="en">Role</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A set of predefined behaviours for an agent with regard to a specific activity.</skos:definition>
    </owl:Class>
	
    <!-- #Objective -->

    <owl:Class rdf:about="#Objective">
        <rdfs:subClassOf rdf:resource="#Control(n)"/>
        <rdfs:label>Objective</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Goal</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&quot;[R]esult to be achieved.&quot; (ISO Annex SL Appendix 2)</skos:definition>
    </owl:Class>

    


    <!-- #NaturalProcess -->

    <owl:Class rdf:about="#NaturalProcess">
        <rdfs:subClassOf rdf:resource="#Process"/>
        <rdfs:label>Natural Process</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A series of interrelated or interacting natural events without a primary human cause.</skos:definition>
    </owl:Class>	
	
	
	<!--TODO: AIA extends impactont:Event with the the 'hasIntentionality' property which can take the values 'INTENTIONAL' or 'UNINTENTIONAL'.-->

	
</rdf:RDF>